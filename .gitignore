# ignore all hidden files and .* files
.*
!.gitignore

# Ignore generated files
*.iml
*.ipr
*.iws
*.log
*.log.*
*.dat
*.pyc
*.ctrl
*.jar
*.war
*.ear
*.h2.db
*.trace.db

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml

hs_err_pid*

# Ignore generated folders
.gradle/
**/.gradle/
bin/
out/
build/
**/build/
target/
**/target/
*/lib/
